class Solution:
    def pathExistenceQueries(self, n: int, nums: List[int], maxDiff: int, queries: List[List[int]]) -> List[int]:
        LOG = 17  # since 2^17 > 1e5

        arr = sorted((v, i) for i, v in enumerate(nums))

        pos = [0] * n          # original index -> sorted position
        comp = [0] * n         # component of original node

        values = [0] * n

        cid = 0
        for i, (v, idx) in enumerate(arr):
            values[i] = v
            pos[idx] = i
            if i and v - arr[i - 1][0] > maxDiff:
                cid += 1
            comp[idx] = cid

        # next reachable position
        nxt = list(range(n))
        r = 0
        for l in range(n):
            while r + 1 < n and values[r + 1] - values[l] <= maxDiff:
                r += 1
            nxt[l] = r

        up = [nxt]
        for _ in range(LOG):
            prev = up[-1]
            cur = [0] * n
            for i in range(n):
                cur[i] = prev[prev[i]]
            up.append(cur)

        ans = []

        for u, v in queries:
            if u == v:
                ans.append(0)
                continue

            if comp[u] != comp[v]:
                ans.append(-1)
                continue

            a = pos[u]
            b = pos[v]

            if a > b:
                a, b = b, a

            cur = a
            jumps = 0

            for k in range(LOG, -1, -1):
                if up[k][cur] < b:
                    cur = up[k][cur]
                    jumps += 1 << k

            ans.append(jumps + 1)

        return ans



