Answer:
class Solution:
    def sumAndMultiply(self, s: str, queries: List[List[int]]) -> List[int]:
        MOD = 10**9 + 7
        n = len(s)

        # prefix count of non-zero digits in original string
        cnt = [0] * (n + 1)

        digits = []

        for i, ch in enumerate(s):
            cnt[i + 1] = cnt[i]
            if ch != '0':
                cnt[i + 1] += 1
                digits.append(int(ch))

        m = len(digits)

        # powers of 10
        pow10 = [1] * (m + 1)
        for i in range(1, m + 1):
            pow10[i] = (pow10[i - 1] * 10) % MOD

        # prefix concatenated value
        pref = [0] * (m + 1)
        # prefix digit sum
        prefSum = [0] * (m + 1)

        for i, d in enumerate(digits):
            pref[i + 1] = (pref[i] * 10 + d) % MOD
            prefSum[i + 1] = prefSum[i] + d

        ans = []

        for l, r in queries:
            a = cnt[l]
            b = cnt[r + 1]

            if a == b:
                ans.append(0)
                continue

            x = (pref[b] - pref[a] * pow10[b - a]) % MOD
            digit_sum = prefSum[b] - prefSum[a]

            ans.append((x * digit_sum) % MOD)

        return ans



