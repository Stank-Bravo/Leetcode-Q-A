Answer:
from collections import Counter
from math import comb
from typing import List

class Solution:
    def smallestPalindrome(self, s: str, k: int) -> str:
        LIMIT = k

        cnt = Counter(s)

        half = {}
        mid = ""
        total = 0

        for ch in sorted(cnt):
            half[ch] = cnt[ch] // 2
            total += half[ch]
            if cnt[ch] & 1:
                mid = ch

        # Returns the number of distinct permutations of the remaining multiset,
        # capped at LIMIT.
        def count_perm(freq, rem):
            ways = 1
            left = rem
            for ch in sorted(freq):
                f = freq[ch]
                if f:
                    ways *= comb(left, f)
                    if ways > LIMIT:
                        return LIMIT + 1
                    left -= f
            return ways

        if count_perm(half, total) < k:
            return ""

        left = []

        while total:
            for ch in sorted(half):
                if half[ch] == 0:
                    continue

                half[ch] -= 1
                ways = count_perm(half, total - 1)

                if ways >= k:
                    left.append(ch)
                    total -= 1
                    break
                else:
                    k -= ways
                    half[ch] += 1

        left = "".join(left)
        return left + mid + left[::-1]



